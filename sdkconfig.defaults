# StageCore ESP32-C3 StageLaser — CI/no-actuation defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# StageCore secure device gateway requires TLS 1.3.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# The qualification unit was measured as embedded 4 MB flash. Keep the
# no-actuation build consistent with the real flash capacity; the production
# OTA partition layout is still deliberately unqualified.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
