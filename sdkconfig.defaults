# StageCore ESP32-C3 StageLaser — CI/no-actuation defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_LOG_DEFAULT_LEVEL_INFO=y

# StageCore secure device gateway requires TLS 1.3.
CONFIG_MBEDTLS_SSL_PROTO_TLS1_3=y
CONFIG_MBEDTLS_SSL_TLS1_3_KEXM_EPHEMERAL=y
CONFIG_MBEDTLS_SSL_TLS1_3_COMPATIBILITY_MODE=y
CONFIG_ESP_TLS_CLIENT_SESSION_TICKETS=y

# Generic CI target only. Physical flash/partition qualification is intentionally
# deferred until the exact ESP32-C3 Super Mini board revision is identified.
